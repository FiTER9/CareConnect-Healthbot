# CareConnect Medical Chatbot Configuration

# Model Configuration
MODEL_NAME=TheBloke/Llama-2-7B-Chat-GGML
MODEL_TYPE=llama
MODEL_DIR=~/.cache/transformers

# Vector Database
DB_FAISS_PATH=vectorstore/db_faiss
DATA_PATH=data/

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Parameters
MAX_NEW_TOKENS=256
TEMPERATURE=0.5
TOP_K=2

# Text Splitting
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Device (cuda or cpu)
# Leave empty for auto-detection
DEVICE=

# Optional: API Keys (if using external services)
# OPENAI_API_KEY=your_key_here
# HUGGINGFACE_API_KEY=your_key_here
